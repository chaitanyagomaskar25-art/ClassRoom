# Server Environment Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bca_student_success

# Security & Authentication (minimum 32 characters required)
JWT_SECRET=production-grade-random-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Optional Redis Caching & BullMQ Background Queue
# (If omitted, system automatically falls back to high-performance in-memory cache and async tasks)
REDIS_URL=redis://127.0.0.1:6379

# AI Provider API Keys (Server-side only — NEVER expose to frontend)
GEMINI_API_KEY=
OPENAI_API_KEY=
